{
  "permissions": {
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/src/github.com/drasewkit/nb"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"/opt/homebrew/bin:$PATH\"; jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in \"{{ .chezmoi.homeDir }}/src/github.com/drasewkit/nb/\"*.md) rumdl fmt \"$f\" ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
