# Target paths chezmoi must never manage. Paths are relative to $HOME.

# --- Repo meta (live in the source repo, not the home dir) ---
README.md
LICENSE
.github/**
Brewfile
bootstrap.sh
docs/**

# --- Secrets / credentials (regenerated per machine, D5) ---
.ssh/**
.gnupg/**
.config/gh/hosts.yml
.config/bitbucket/**
.netrc
.claude.json
.mysql_history

# --- Work-local, machine-local overrides (D6) ---
.config/local/**
.claude/settings.local.json

# --- Auto-generated / tool-managed (regenerated on a new machine) ---
.config/karabiner/automatic_backups/**

# --- History / state / caches (not portable) ---
.cache/**
.local/state/**
.config/zsh/.zsh_history
.config/zsh/.zcompdump*
.config/zsh/.zcompdump*.zwc

# --- OS cruft ---
**/.DS_Store
