{{/*
Written to ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
The source lives under the ghq tree so Ctrl-] fzf reaches it like any repo;
bootstrap.sh clones it there and points `chezmoi init --source` at it.
*/ -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[git]
    # Repo is public (D2); autoCommit is local-only so it's low-risk, but
    # autoPush stays manual so a diff gets reviewed before it reaches GitHub.
    autoCommit = true
    autoPush   = false
